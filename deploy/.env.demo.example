APP_ENV=demo
ALLOW_ANONYMOUS_DEMO=true
DEV_AUTH_BYPASS_ENABLED=false
DOCS_ENABLED=false
PUBLIC_HOST=:80
PUBLIC_API_BASE_URL=http://localhost:8080
ACME_EMAIL=admin@example.com
HTTP_PORT=8080
HTTPS_PORT=8443
CORS_ORIGINS=["http://localhost:8080"]
TRUSTED_HOSTS=["demo.example.com","localhost","127.0.0.1"]
POSTGRES_PASSWORD=replace-with-a-long-random-secret
METRICS_INTERNAL_TOKEN=replace-with-a-long-random-secret
REDIS_URL=redis://redis:6379/0
REDIS_KEY_NAMESPACE=groundstack
DEMO_CHAT_ENABLED=true
DEMO_REDIS_REQUIRED=false
DEMO_REQUEST_LIMIT_PER_MINUTE=8
DEMO_DAILY_QUESTION_LIMIT=100
DEMO_DAILY_TOKEN_LIMIT=15000
DEMO_MAX_QUESTION_LENGTH=600
DEMO_PROVIDER_FAILURE_THRESHOLD=5
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=500
LLM_MAX_CONCURRENT_REQUESTS=2
