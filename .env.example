# GroundStack local development configuration.
# Copy this file to .env and adjust values for your machine.

APP_NAME=GroundStack
APP_ENV=development
ENVIRONMENT=local
LOG_LEVEL=INFO
PUBLIC_API_BASE_URL=http://localhost:8000

POSTGRES_USER=groundstack
POSTGRES_PASSWORD=groundstack
POSTGRES_DB=groundstack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://groundstack:groundstack@localhost:5432/groundstack
DATABASE_DIRECT_URL=
DB_SSL_REQUIRED=false
DB_POOL_SIZE=5
REDIS_URL=
REDIS_TIMEOUT_SECONDS=1.5
REDIS_KEY_NAMESPACE=groundstack

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Ingestion and embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=auto
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=60
MAX_INGESTION_FILE_SIZE_BYTES=10485760
# Comma-separated hostnames that server-side URL ingestion may fetch.
URL_INGESTION_ALLOWED_DOMAINS=["docs.example.com"]

# Retrieval
MAX_RETRIEVAL_QUERY_LENGTH=1200
VECTOR_CANDIDATE_LIMIT=40
LEXICAL_CANDIDATE_LIMIT=40
RRF_K=60
VECTOR_RRF_WEIGHT=1.0
LEXICAL_RRF_WEIGHT=1.0
RERANK_CANDIDATE_LIMIT=20
RETRIEVAL_FINAL_TOP_K=8
RETRIEVAL_MAX_TOP_K=20
MAX_CHUNKS_PER_SOURCE=3
RETRIEVAL_ALGORITHM_VERSION=hybrid-rrf-ce-v1
RERANKER_PROVIDER=sentence_transformers
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_BATCH_SIZE=16
RERANKER_DEVICE=auto
RERANKING_ENABLED=true
PERSIST_RETRIEVAL_QUERIES=false
RETRIEVAL_DEBUG_ENABLED=true
RETRIEVAL_TIMEOUT_SECONDS=30

# Grounded generation
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_MAX_OUTPUT_TOKENS=700
LLM_CONTEXT_WINDOW=8192
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_PREWARM=false
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_MODEL_VARIANT=base
LLM_ADAPTER_NAME=
LLM_ADAPTER_VERSION=
LLM_DATASET_VERSION=
LLM_MODEL_MANIFEST_CHECKSUM=
LLM_EVALUATION_STATUS=not_evaluated
LLM_PROMOTION_STATUS=created
TOKENIZER_MODEL_NAME=
STORE_GENERATION_PROMPTS=false
GENERATION_PROMPT_VERSION=grounded_answer/v1
MAX_CONVERSATION_HISTORY_MESSAGES=8

# Feedback, rate limits, and observability
FEEDBACK_RATE_LIMIT_PER_MINUTE=30
CHAT_RATE_LIMIT_PER_MINUTE=20
RETRIEVAL_RATE_LIMIT_PER_MINUTE=60
GENERATION_CONCURRENCY=2
RETRIEVAL_CONCURRENCY=4
MODEL_QUEUE_TIMEOUT_SECONDS=3
METRICS_ENABLED=true
METRICS_INTERNAL_TOKEN=
EVALUATION_ADMIN_ENABLED=false
OTEL_TRACING_ENABLED=false
OTLP_ENDPOINT=

# Discord integration
DISCORD_INTEGRATION_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_INTERACTION_TOKEN_ENCRYPTION_KEY=
DISCORD_IDENTITY_HMAC_KEY=
DISCORD_SIGNATURE_TOLERANCE_SECONDS=300
DISCORD_DEFAULT_RETENTION_DAYS=30
DISCORD_MAX_QUESTION_LENGTH=600
DISCORD_QUEUE_TTL_SECONDS=900
DISCORD_WORKER_BATCH_SIZE=5
DISCORD_WORKER_MAX_RETRIES=2
DISCORD_RESPONSE_BASE_URL=https://discord.com/api/v10
DISCORD_FULL_ANSWER_BASE_URL=
DISCORD_ALLOW_DMS=false

# Authentication and production security
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
OIDC_SCOPES=openid profile email
OIDC_ROLE_CLAIM=roles
OIDC_ADMIN_ROLE=admin
OIDC_ALLOWED_ALGORITHMS=["RS256"]
SESSION_COOKIE_NAME=groundstack_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_SECONDS=3600
ALLOW_ANONYMOUS_DEMO=false
DEMO_CHAT_ENABLED=true
DEMO_ALLOWLIST_MODE=false
DEMO_ALLOWLIST_IPS=[]
DEMO_REQUEST_LIMIT_PER_MINUTE=8
DEMO_DAILY_QUESTION_LIMIT=100
DEMO_DAILY_TOKEN_LIMIT=15000
DEMO_MAX_QUESTION_LENGTH=600
DEMO_MAX_CONTEXT_TOKENS=2500
DEMO_PROVIDER_FAILURE_THRESHOLD=5
DEMO_PROVIDER_FAILURE_WINDOW_SECONDS=300
DEMO_REDIS_REQUIRED=false
DEMO_UPLOAD_LIMIT_BYTES=0
DEMO_MAX_CONVERSATIONS=5
DEV_AUTH_BYPASS_ENABLED=true
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","test"]
TRUSTED_PROXY_HOSTS=[]
CSRF_COOKIE_NAME=groundstack_csrf
CSRF_HEADER_NAME=x-groundstack-csrf
DOCS_ENABLED=true
MAX_REQUEST_BODY_BYTES=12582912
